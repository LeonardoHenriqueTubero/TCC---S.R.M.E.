{
  "name": "srme",
  "version": "1.0.0",
  "description": "Sistema de Registro de Músicos em Eventos",
  "homepage": "https://github.com/leonardotubero/srme",
  "author": {
    "name": "Leonardo Tubero",
    "email": "leonardohenriquetubero@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonardotubero/srme.git"
  },
  "license": "MIT",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && electron-rebuild",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron --inspect=5858 ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json -p always",
    "electron:make:linux": "npm run build && electron-builder build --linux -c ./electron-builder.config.json -p never",
    "electron:make:win": "./empacotar-windows.sh x64",
    "electron:make:win32": "./empacotar-windows.sh ia32"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "chokidar": "~3.5.3",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "~2.0.0",
    "electron-json-storage": "^4.6.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-updater": "^5.3.0",
    "electron-window-state": "^5.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ]
}
