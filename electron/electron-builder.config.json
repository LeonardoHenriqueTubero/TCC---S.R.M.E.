{
  "appId": "br.com.tubero.srme",
  "productName": "S.R.M.E.",
  "directories": {
    "buildResources": "resources"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*"
  ],
  "publish": {
    "provider": "github"
  },
  "nsis": {
    "artifactName": "${productName} Setup ${version} ${arch}.${ext}",
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": "nsis",
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.productivity",
    "target": "dmg"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/appIcon.png",
    "category": "Office",
    "maintainer": "Leonardo Tubero <leonardohenriquetubero@gmail.com>",
    "synopsis": "Sistema de Registro de Músicos em Eventos"
  }
}